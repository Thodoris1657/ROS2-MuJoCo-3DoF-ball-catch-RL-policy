<?xml version="1.0"?>
<!-- URDF twin of assets/arm3.xml, for RViz / robot_state_publisher.
     Kinematics (joint origins, axes, limits) are checked against MuJoCo forward
     kinematics by test/test_urdf.py; keep the two in sync.
     URDF has no capsules, so links are cylinders with a sphere on the far end. -->
<robot name="arm3">
  <material name="metal"><color rgba="0.55 0.58 0.62 1"/></material>
  <material name="accent"><color rgba="0.90 0.45 0.10 1"/></material>

  <link name="world"/>

  <link name="base">
    <visual>
      <geometry><cylinder radius="0.07" length="0.10"/></geometry>
      <material name="metal"/>
    </visual>
  </link>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/><child link="base"/>
    <origin xyz="0 0 0.05"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry><cylinder radius="0.045" length="0.12"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="metal"/>
    </visual>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base"/><child link="link1"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="20" velocity="3.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.125"/>
      <geometry><cylinder radius="0.038" length="0.25"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><sphere radius="0.038"/></geometry>
      <material name="metal"/>
    </visual>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.12"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="25" velocity="3.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.125"/>
      <geometry><cylinder radius="0.030" length="0.25"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><sphere radius="0.030"/></geometry>
      <material name="metal"/>
    </visual>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 0.25"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="15" velocity="3.0"/>
  </joint>

  <link name="ee">
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="link3_to_ee" type="fixed">
    <parent link="link3"/><child link="ee"/>
    <origin xyz="0 0 0.25"/>
  </joint>
</robot>
