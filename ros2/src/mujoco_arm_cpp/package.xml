<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mujoco_arm_cpp</name>
  <version>0.2.0</version>
  <description>C++ ROS 2 bridge for the MuJoCo 3-joint arm: reach and ball-catch (Earth/Mars/Moon) simulator nodes on the MuJoCo C API, a policy node running the model-based catch controller, the IK oracle or exported RL networks, ReachTarget and CatchBall action servers, benchmark clients.</description>
  <maintainer email="theodoris.fragos@gmail.com">Thodoris Fragos</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_cpp</depend>
  <depend>mujoco_arm_interfaces</depend>
  <depend>nlohmann-json-dev</depend>
  <!-- MuJoCo (C library + headers) is taken from the `mujoco` pip wheel of the active Python;
       no rosdep key. See CMakeLists.txt to point it at a release tarball instead. -->

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
